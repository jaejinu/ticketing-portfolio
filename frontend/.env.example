# 프론트엔드 환경변수 예시. 실제 .env.local 은 git 에 포함하지 않는다.
#
# Public 변수는 클라이언트 번들에 그대로 들어가므로 비밀값 절대 금지.

# 백엔드 REST API 베이스 URL.
# app-gateway 의 컨텍스트 패스가 /api/v1 인 것에 맞춤.
NEXT_PUBLIC_API_BASE=http://localhost:8088/api/v1

# WebSocket(STOMP) 엔드포인트.
# app-gateway 가 /ws 로 SockJS + raw WebSocket 둘 다 받도록 열어둘 예정.
NEXT_PUBLIC_WS_BASE=ws://localhost:8088/ws
