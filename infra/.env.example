# =============================================================================
# 다이나믹 프라이싱 티켓팅 — 로컬 인프라 환경 변수
# -----------------------------------------------------------------------------
# 이 파일은 docker-compose가 `--env-file infra/.env` 로 읽어들이는 기본 값들.
# `make up` 시 .env가 없으면 이 파일이 자동 복사된다.
# 비밀이 아닌 로컬 개발용 기본값만 들어있다. (실제 운영 비밀은 절대 커밋 X)
# =============================================================================

# -----------------------------------------------------------------------------
# 공용 / Compose 프로젝트 이름
# -----------------------------------------------------------------------------
# COMPOSE_PROJECT_NAME: 컨테이너/네트워크 prefix. 다른 프로젝트와 충돌 방지.
COMPOSE_PROJECT_NAME=ticketing
# Host published ports default to loopback. k3d host-bridge access needs an explicit override.
DEV_BIND_ADDRESS=127.0.0.1

# -----------------------------------------------------------------------------
# PostgreSQL + TimescaleDB
# -----------------------------------------------------------------------------
# POSTGRES_USER/PASSWORD/DB: 컨테이너 init 시 자동 생성되는 슈퍼유저/DB.
# 백엔드 application.yml의 spring.datasource.url과 일치해야 한다.
POSTGRES_USER=ticket
POSTGRES_PASSWORD=ticket
POSTGRES_DB=ticketing
# POSTGRES_PORT: host 노출 포트. 백엔드 application-local.yml 의 DB_URL 기본값(5440)과 일치.
#   표준 5432 를 피한 이유: 로컬에 이미 떠 있는 Postgres 와 충돌하지 않도록.
#   바꾸면 백엔드 실행 시 DB_URL 도 함께 지정해야 한다.
POSTGRES_PORT=5440
# Optional locally built hardened image; build/verify it first (infra/README.md).
# POSTGRES_IMAGE=ticketing-postgres:2.30.2-pg16-hardened-20261006

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# 좌석 점유 락 / 캐시 / 큐 토큰 발급용.
# 백엔드 REDIS_PORT 기본값(6390)과 일치. make backend 가 이 값을 export 하므로 바꿔도 자동 동기화.
REDIS_PORT=6390

# -----------------------------------------------------------------------------
# Kafka (KRaft 단일 노드 모드)
# -----------------------------------------------------------------------------
# 외부에서 접속할 때 사용 — 포트폴리오 한정. 멀티 브로커는 ADR 한계 참고.
KAFKA_PORT=9092
# KRaft 컨트롤러 통신 포트 (외부 노출 안 해도 되지만 명시).
KAFKA_CONTROLLER_PORT=9093
# KRaft 클러스터 ID — uuidgen 결과를 base64 22자로 자른 값.
# 한 번 정해두면 볼륨 재사용해도 OK. 변경 시 nuke 후 재기동 필요.
KAFKA_KRAFT_CLUSTER_ID=ticketing-kafka-cluster

# -----------------------------------------------------------------------------
# Mailpit (SMTP mock)
# -----------------------------------------------------------------------------
# 1025 = SMTP 수신, 8025 = 웹 UI (브라우저에서 메일 확인).
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# -----------------------------------------------------------------------------
# FCM Mock (푸시 알림 흉내)
# -----------------------------------------------------------------------------
# 백엔드 notification 모듈이 "FCM_MODE=mock" 일 때 이 서비스로 보낸다.
FCM_MOCK_PORT=8086

# -----------------------------------------------------------------------------
# Mock PG (결제 게이트웨이 흉내)
# -----------------------------------------------------------------------------
# 95% 성공 / 4% 카드한도초과(402) / 1% 5초 타임아웃 시나리오를 시뮬레이션.
# MOCK_PG_SEED를 고정하면 재현 가능한 분포가 나옴.
MOCK_PG_PORT=8087
MOCK_PG_SEED=42

# -----------------------------------------------------------------------------
# 알림 모드 토글 (백엔드가 읽는 값들 — infra에선 직접 안 쓰지만 한 곳에 모아둠)
# -----------------------------------------------------------------------------
# 모드 표기용. SMTP 실제 연결은 SMTP_HOST/SMTP_PORT로 설정하며 이 값만으로 전환되지 않음.
NOTIFICATION_EMAIL_MODE=mock
NOTIFICATION_PUSH_MODE=mock

# -----------------------------------------------------------------------------
# 관측성 (LGTM 스택)
# -----------------------------------------------------------------------------
# OTel Collector OTLP 수신 포트. 백엔드 OTEL_EXPORTER_OTLP_ENDPOINT가 이걸 가리킴.
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318

# Grafana — 3000 은 Next.js 등 다른 dev 서버와 자주 겹쳐 3031 로 둔다.
GRAFANA_PORT=3031
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# 백엔드 데이터 스토리지 — 직접 포트 노출은 디버깅 용도.
LOKI_PORT=3100
TEMPO_HTTP_PORT=3200
TEMPO_GRPC_PORT=9095
MIMIR_PORT=9009

# LGTM backup/restore: leave unset for a fresh Compose-managed installation.
# For restored existing volumes, set LGTM_VOLUMES_EXTERNAL=true and the four names.
# LGTM_VOLUMES_EXTERNAL=true
# LOKI_DATA_VOLUME=ticketing_loki-data-restored
# TEMPO_DATA_VOLUME=ticketing_tempo-data-restored
# MIMIR_DATA_VOLUME=ticketing_mimir-data-restored
# GRAFANA_DATA_VOLUME=ticketing_grafana-data-restored

# Core backup/restore: leave unset for a fresh Compose-managed installation.
# CORE_VOLUMES_EXTERNAL=true
# POSTGRES_DATA_VOLUME=ticketing_postgres-data-restored
# REDIS_DATA_VOLUME=ticketing_redis-data-restored
# KAFKA_DATA_VOLUME=ticketing_kafka-data-restored

# Optional verified local images (build and scan before setting).
# REDIS_IMAGE=ticketing-redis:7.4.11-hardened-20261006
# KAFKA_IMAGE=ticketing-kafka:4.3.1-hardened-20261006
# GRAFANA_IMAGE=ticketing-grafana:13.2.3-hardened-20261006
