# infra/.env.public-demo 의 키 목록 — 값은 예시, 비밀값은 비워 둔다. 실제 파일은 git 에서 제외된다.
JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
SPRING_PROFILES_ACTIVE=local,public-demo
# 개발용 백엔드(8088)·관리 포트(8081)와 겹치지 않게.
SERVER_PORT=18088
MANAGEMENT_SERVER_PORT=18081
DB_URL=jdbc:postgresql://127.0.0.1:5440/ticketing_public_demo
DB_USER=ticketing_demo_app
DB_PASSWORD=
# 데모 전용 Redis 컨테이너 (scripts/public-demo.py ensure-deps 가 만든다).
REDIS_HOST=127.0.0.1
REDIS_PORT=6391
PUBLIC_DEMO_REDIS_DATABASE=0
PUBLIC_DEMO_REDIS_PASSWORD=
KAFKA_BOOTSTRAP=localhost:9092
# prepare_backend 가 실행 폴더의 사본 경로로 바꿔 쓴다.
JWT_PRIVATE_KEY_PATH=build/public-demo/keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=build/public-demo/keys/jwt-public.pem
JWT_AUTO_GENERATE=false
AUTH_CORS_ORIGINS=https://ticketing-demo-five.vercel.app
# Vercel 인증 프록시와 같은 값 — publish 가 Vercel production env 에도 넣는다. 방문자 IP 를 믿을 때 쓴다.
AUTH_PROXY_SECRET=
PUBLIC_DEMO_PASSWORD_HASH=
MOCK_PG_BASE_URL=http://127.0.0.1:8097
SHOW_SEED_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=public-demo,service.instance.id=public-demo
