    {
      "id": 4,
      "title": "좌석 hold — 생성 vs 충돌 (중복판매 0 의 실시간 증거)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(seat_holds_created_total[1m])) * 60",
          "legendFormat": "created/min"
        },
        {
          "refId": "B",
          "expr": "sum(rate(seat_holds_conflicts_total[1m])) * 60",
          "legendFormat": "conflicts/min (분산락 방어)"
        },
        {
          "refId": "C",
          "expr": "seat_holds_active",
          "legendFormat": "active holds"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
